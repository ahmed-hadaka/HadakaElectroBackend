# Stage 1: Build ElectroCommon and ElectroCustomerApi
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .
RUN mvn clean install -pl ElectroCommon,ElectroCustomerApi -am -DskipTests

# Stage 2: Run the Customer API executable jar
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/ElectroCustomerApi/target/ElectroCustomerApi-0.0.1-SNAPSHOT.jar app.jar
ENTRYPOINT ["sh", "-c", "java -Dserver.port=${PORT:-8081} -jar app.jar"]